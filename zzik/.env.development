# Design Loop 환경 설정 - 개발 모드
# 개발 중에는 관대한 임계값 사용

# 개발 서버 URL
TEST_URL=http://localhost:3000

# Dry run 모드 (Percy 없이 로컬 테스트만)
DRY_RUN=true

# Percy 토큰 (나중에 설정)
# PERCY_TOKEN=your_percy_token_here

# 임계값 (개발 중에는 조금 더 관대하게)
THRESHOLD_VISUAL_DIFF=0.10      # 10% (개발 중)
THRESHOLD_A11Y_CRITICAL=0       # Critical 위반 0개
THRESHOLD_A11Y_SERIOUS=5        # Serious 위반 5개까지 허용
THRESHOLD_DOM_DEPTH=18          # DOM depth 18 레벨

# 디버그 모드
DEBUG=false

# 뷰포트 설정 (콤마로 구분)
VIEWPORTS=desktop,tablet,mobile

# 테스트 타임아웃 (초)
TEST_TIMEOUT=30

# 스크린샷 저장 여부
SAVE_SCREENSHOTS=true
SCREENSHOT_DIR=./test-results/screenshots
