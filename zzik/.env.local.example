# ===========================
# ZZIK Backend Environment Variables Template
# ===========================
# 📋 Copy this file to `.env.local` and fill in your actual API keys
# 💡 Command: cp .env.local.example .env.local
# ===========================

# --- Application Config ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI API ---
# 용도: AI 챗봇 응답 생성
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# --- Facebook OAuth ---
# 용도: 소셜 로그인
# 발급: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# --- Instagram Graph API ---
# 용도: Instagram 계정 연동
# 발급: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# --- Stripe Payment ---
# 용도: 결제 처리
# 발급: https://dashboard.stripe.com/apikeys
# ⚠️  Use test keys (pk_test_* / sk_test_*) for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe 가격 ID
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# --- SendGrid Email ---
# 용도: 이메일 발송
# 발급: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.
SENDGRID_FROM_EMAIL=noreply@yourcompany.com
SENDGRID_FROM_NAME=ZZIK

# SendGrid 템플릿 ID
SENDGRID_TEMPLATE_WELCOME=
SENDGRID_TEMPLATE_PASSWORD_RESET=

# --- Database (Optional) ---
# DATABASE_URL=

# --- Session Secret (Optional) ---
# SESSION_SECRET=

# --- CORS Settings (Optional) ---
# NEXT_PUBLIC_FRONTEND_URL=
