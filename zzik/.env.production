# Design Loop 환경 설정 - 프로덕션 모드
# PR 전에는 엄격한 임계값 사용

# 개발 서버 URL
TEST_URL=http://localhost:3000

# Percy 모드 (실제 시각 회귀 테스트)
DRY_RUN=false

# Percy 토큰 (GitHub Secrets에서 주입됨)
PERCY_TOKEN=${PERCY_TOKEN}

# 임계값 (프로덕션 - 엄격)
THRESHOLD_VISUAL_DIFF=0.05      # 5% (오케스트레이션 규칙)
THRESHOLD_A11Y_CRITICAL=0       # Critical 위반 0개
THRESHOLD_A11Y_SERIOUS=0        # Serious 위반 0개
THRESHOLD_DOM_DEPTH=15          # DOM depth 15 레벨

# 디버그 모드
DEBUG=false

# 뷰포트 설정
VIEWPORTS=desktop,tablet,mobile

# 테스트 타임아웃
TEST_TIMEOUT=60

# 스크린샷 저장
SAVE_SCREENSHOTS=true
SCREENSHOT_DIR=./test-results/screenshots
