// ============================================
// ZZIK SNS 로그인 데이터베이스 스키마
// ============================================
// 
// 🎯 설계 전략:
// 1. 한 명의 사용자가 여러 SNS로 로그인 가능 (Facebook, Instagram, TikTok, Google 등)
// 2. 같은 이메일이면 자동으로 계정 병합
// 3. NextAuth.js/Auth.js 표준 스키마 기반
// 4. Stripe 구독 정보 통합
// 
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 개발용 (프로덕션은 "postgresql" 추천)
  url      = env("DATABASE_URL")
}

// ============================================
// 핵심 사용자 테이블
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  
  // 사용자 메타데이터
  username      String?   @unique  // 사용자가 직접 설정한 username
  bio           String?              // 프로필 소개
  phone         String?              // 전화번호
  
  // Stripe 구독 정보
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  
  // 시스템 필드
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  
  @@map("users")
}

// ============================================
// SNS 계정 연결 테이블 (핵심!)
// ============================================
// 한 명의 User가 여러 SNS 계정을 연결할 수 있음
// 예: Facebook, Instagram, TikTok, Google 동시 연결 가능

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth", "email", "credentials"
  provider          String  // "facebook", "instagram", "tiktok", "google" 등
  providerAccountId String  // SNS에서 부여한 사용자 ID
  
  // OAuth 토큰 정보
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  // SNS 프로필 추가 정보 (선택사항)
  profile_picture   String?  // SNS 프로필 사진 URL
  profile_username  String?  // SNS username (예: @qetta_t)
  follower_count    Int?     // 팔로워 수
  following_count   Int?     // 팔로잉 수
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ============================================
// 세션 테이블 (로그인 상태 관리)
// ============================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("sessions")
}

// ============================================
// 이메일 인증 토큰 테이블
// ============================================

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 추가: 사용자 활동 로그 (선택사항)
// ============================================

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "login", "logout", "profile_update", "subscription_change" 등
  provider  String?  // 어떤 SNS로 로그인했는지
  metadata  Json?    // 추가 정보 (JSON 형태)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([type])
  @@map("user_activities")
}

// ============================================
// 사용 예시:
// ============================================
//
// 1. Facebook으로 처음 로그인:
//    - User 생성 (email: user@example.com)
//    - Account 생성 (provider: "facebook")
//
// 2. 같은 사용자가 Instagram으로 로그인 (같은 이메일):
//    - 기존 User 찾기 (email로)
//    - Account 추가 생성 (provider: "instagram")
//    - 이제 User 1명에게 Account 2개 연결됨
//
// 3. TikTok으로 로그인 (같은 이메일):
//    - 기존 User 찾기
//    - Account 추가 생성 (provider: "tiktok")
//    - 이제 User 1명에게 Account 3개 연결됨
//
// 4. 사용자가 어떤 SNS로든 로그인 가능:
//    - Session 생성 (userId 연결)
//    - 모든 연결된 SNS 계정 정보 조회 가능
//
// ============================================
