{
  "name": "zzik-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup:sendgrid": "tsx scripts/setup-sendgrid.ts",
    "setup:instagram": "tsx scripts/setup-instagram.ts",
    "setup:stripe": "tsx scripts/setup-stripe.ts",
    "setup:tiktok": "tsx scripts/setup-tiktok.ts",
    "setup:rapidapi": "tsx scripts/setup-rapidapi.ts",
    "setup:database": "tsx scripts/setup-database.ts",
    "setup:quick": "tsx scripts/quick-setup.ts",
    "test:apis": "tsx scripts/test-apis.ts",
    "setup:all": "npm run setup:sendgrid && npm run setup:instagram && npm run setup:stripe",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "design:review": "playwright test tests/visual",
    "design:update": "playwright test tests/visual --update-snapshots",
    "design:report": "playwright show-report",
    "design:ui": "playwright test --ui",
    "design:validate": "tsx design-system/design-reviewer.ts",
    "design:test": "playwright test tests/visual/design-system-validation.spec.ts",
    "design:test:ui": "playwright test tests/visual/design-system-validation.spec.ts --ui",
    "design:full-review": "tsx design-system/run-full-review.ts",
    "design:full-review:strict": "tsx design-system/run-full-review.ts --strict",
    "design:rules": "cat design-system/DESIGN_RULES.json | jq .",
    "design:rules:colors": "cat design-system/DESIGN_RULES.json | jq .colorPalette",
    "design:rules:components": "cat design-system/DESIGN_RULES.json | jq .components",
    "design:rules:accessibility": "cat design-system/DESIGN_RULES.json | jq .accessibility",
    "loop:start": "tsx design-system/loop-agent/run-loop.ts",
    "loop:auto": "tsx design-system/loop-agent/run-loop.ts --auto",
    "loop:manual": "tsx design-system/loop-agent/run-loop.ts --manual",
    "loop:status": "curl -s http://localhost:3000/api/design-loop/status | jq .",
    "loop:report": "curl -s http://localhost:3000/api/design-loop/report | jq ."
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@types/jszip": "^3.4.0",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "motion": "^12.23.11",
    "next": "^15.0.0",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prisma/client": "^6.17.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "fast-glob": "^3.3.3",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
